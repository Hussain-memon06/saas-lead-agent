# Copy to .env and fill in real values. Never commit .env.
TAVILY_API_KEY=tvly-...
OPENAI_API_KEY=sk-...
HUNTER_API_KEY=...

# Phase 6: Clerk authentication
# Production must use APP_ENV=production and must never enable the dev bypass.
APP_ENV=development
AUTH_DEV_BYPASS_ENABLED=true
# Clerk Frontend API/issuer URL, e.g. https://example.clerk.accounts.dev
CLERK_ISSUER=https://example.clerk.accounts.dev
# Optional overrides/constraints. JWKS defaults to <CLERK_ISSUER>/.well-known/jwks.json.
# CLERK_JWKS_URL=https://example.clerk.accounts.dev/.well-known/jwks.json
# CLERK_AUDIENCE=your-api-audience
# CLERK_AUTHORIZED_PARTIES=https://agent.hussainflow.com,http://localhost:3000
# Required in production; comma-separated, no wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:3000
MAX_REQUEST_BODY_BYTES=128000
RATE_LIMIT_ENABLED=true
QUALIFY_RATE_LIMIT_PER_MINUTE=10
DECISION_RATE_LIMIT_PER_MINUTE=30
# Lifetime dossier-build allowance per authenticated account.
QUALIFY_ACCOUNT_LIMIT=3

# Phase 3: Postgres persistence (AsyncPostgresSaver)
# Local dev (docker):  postgresql://saas_lead:password@localhost:5432/saas_lead
# Supabase:            postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
# Leave unset to use InMemorySaver (tests / no-DB dev mode)
# POSTGRES_URL=postgresql://saas_lead:password@localhost:5432/saas_lead

# Phase 3: SendGrid email delivery
# Set SENDGRID_STUB_ENABLED=true for explicit dev/test stub mode.
# Stub mode returns send_result="stubbed" and never reports a real send.
SENDGRID_STUB_ENABLED=true
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxx
# SENDGRID_FROM_EMAIL=sales@yourdomain.com

# Phase 3: Langfuse v3 observability
# Leave LANGFUSE_PUBLIC_KEY unset to disable tracing (graph runs unaffected).
# LANGFUSE_HOST defaults to https://cloud.langfuse.com when omitted.
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxx
# LANGFUSE_HOST=https://cloud.langfuse.com
