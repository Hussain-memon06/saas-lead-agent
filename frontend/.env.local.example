# Copy to .env.local and customise.  Never commit real values.

# Production-style mode: when set, the frontend calls this URL directly
# (no Next.js rewrite).  Leave unset in dev so Next.js proxies /api/*
# to BACKEND_PROXY_TARGET (default http://localhost:8080).
# NEXT_PUBLIC_API_BASE_URL=https://api.outbound-lead-agent.example.com

# Override the dev proxy target if your FastAPI listens elsewhere.
# BACKEND_PROXY_TARGET=http://localhost:8080
