  "cases": [
    {
      "case_id": "retrieval.icp-sales-automation",
      "category": "retrieval",
      "description": "A sales automation query should retrieve the matching trusted ICP chunks.",
      "input": {
        "query": "Series B sales automation companies hiring RevOps",
        "retrieved_chunks": [
          {
            "chunk_id": "icp-sales-1",
            "document_id": "doc-icp-sales",
            "document_type": "icp",
            "trust_label": "trusted_user",
            "text": "Target Series B sales automation companies hiring RevOps.",
            "token_count": 9,
            "score": 0.95,
            "source_uri": "user://icp/sales"
          },
          {
            "chunk_id": "icp-health-1",
            "document_id": "doc-icp-health",
            "document_type": "icp",
            "trust_label": "trusted_user",
            "text": "Target healthcare providers modernizing patient intake.",
            "token_count": 7,
            "score": 0.7,
            "source_uri": "user://icp/health"
          },
          {
            "chunk_id": "offer-sales-1",
            "document_id": "doc-offer-sales",
            "document_type": "offer",
            "trust_label": "trusted_user",
            "text": "Sales workflow automation for growing RevOps teams.",
            "token_count": 7,
            "score": 0.65,
            "source_uri": "user://offer/sales"
          }
        ]
      },
      "expected": {
        "expected_chunk_ids": ["icp-sales-1", "offer-sales-1"],
        "expected_source_uris": ["user://icp/sales", "user://offer/sales"],
        "retrieval_k": 3,
        "min_recall_at_k": 1.0,
        "min_precision_at_k": 0.66,
        "min_mrr": 1.0,
        "min_source_coverage": 1.0
      },
      "tags": ["retrieval", "icp", "offer"]
    },
    {
