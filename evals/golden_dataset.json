      },
      "tags": ["scoring", "low-fit", "missing-data"]
    },
    {
      "case_id": "structured.lead-report-required-fields",
      "category": "structured_output",
      "description": "A lead report fixture should preserve its required API-facing fields.",
      "input": {
        "output": {
          "thread_id": "lead:acme.example.com",
          "fit_score": 9,
          "fit_level": "high",
          "email_subject": "Acme sales automation",
          "email_body": "Hi Alex, your recent RevOps hiring suggests a timely workflow opportunity."
        }
      },
      "expected": {
        "output_schema": "qualify_response",
        "required_fields": ["thread_id", "fit_score", "fit_level", "email_subject", "email_body"]
      },
      "tags": ["structured-output", "lead-report"]
    },
