  "kind": "golden",
  "cases": [
    {
      "case_id": "scoring.high-fit-saas",
      "category": "scoring",
      "description": "A sourced Series B SaaS company matching every ICP dimension should be high fit.",
      "input": {
        "profile": {
          "name": "Acme Corp",
          "tagline": "B2B SaaS workflow automation for sales teams",
          "hq": "New York, United States",
          "employees_estimate": "51-200",
          "funding_stage": "Series B",
          "products": ["Sales automation platform"],
          "notable_customers": ["ExampleCo"],
          "sources": ["https://acme.example.com/about"]
        },
        "contact": {
          "name": "Alex Smith",
          "title": "VP Sales",
          "email": "alex@acme.example.com",
          "confidence": 92,
          "source": "hunter"
        },
        "signals": [
          {
            "signal_type": "funding",
            "date": "2026-01",
            "source": "https://acme.example.com/news",
            "details": "Acme announced recent funding to expand sales automation."
          },
          {
            "signal_type": "hiring",
            "date": "2026-02",
            "source": "https://acme.example.com/careers",
            "details": "Acme is hiring sales and RevOps roles."
          }
        ],
        "icp": {
          "target_industries": ["B2B SaaS"],
          "target_stages": ["Series B"],
          "target_geographies": ["United States"],
          "target_employees": "51-200",
          "must_have_signals": ["recent funding", "hiring sales"],
          "red_flags": ["consumer app"]
        }
      },
      "expected": {
        "expected_fit_level": "high",
        "min_score": 8,
        "max_score": 10,
        "requires_human_approval": false
      },
      "tags": ["scoring", "high-fit", "saas"]
    },
    {
      "case_id": "scoring.low-fit-missing-profile",
      "category": "scoring",
      "description": "A lead with no profile, contact, or signals should remain low confidence and low fit.",
